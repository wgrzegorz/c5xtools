repository-code: "https://github.com/wgrzegorz/c5xtools"
url: "https://github.com/wgrzegorz/c5xtools"
license: MIT
version: 1.0.3
date-released: "2026-10-06"
keywords:
  - tms320c5x
  - dsp
  - assembler
  - linker
  - disassembler
  - coff
